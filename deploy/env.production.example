# Copy to the server as  .env.production  (repository root, chmod 600) and fill in. Never commit it.
# Used as:  docker compose --env-file .env.production ...

# --- How the internet reaches this machine ---------------------------------------------------
# caddy  = public server, Let's Encrypt (needs ACME_EMAIL, ports 80/443 open)
# tunnel = behind a router, e.g. a Mac mini (needs CLOUDFLARE_TUNNEL_TOKEN; no open ports)
COMPOSE_PROFILES=caddy
DOMAIN=darerp.net
# caddy only:
ACME_EMAIL=
# tunnel only: the token of the tunnel created in Cloudflare Zero Trust → Networks → Tunnels.
CLOUDFLARE_TUNNEL_TOKEN=
# caddy only. Household subdomains to serve, space-separated. Add one after creating a household, then:
#   docker compose --env-file .env.production up -d caddy
TENANT_HOSTS=

# --- Supabase (auth) -------------------------------------------------------------------------
# Project URL without a trailing slash, e.g. https://abcd.supabase.co (self-hosted: its public URL).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# service_role: reaches the API container only.
SUPABASE_SERVICE_ROLE_KEY=

# --- Database (Supabase Postgres; use the DIRECT connection, port 5432, sslmode=require) -----
# Owner connection: used ONLY by `run --rm db`. Remove it from this file once the database is set up, if you prefer.
DB_OWNER_URL=
# Passwords the setup gives to the two service roles (20+ characters each: openssl rand -hex 24).
HERP_API_DB_PASSWORD=
HERP_WORKER_DB_PASSWORD=
# The services connect as those roles:
DATABASE_URL=postgresql://herp_api:<HERP_API_DB_PASSWORD>@<db host>:5432/postgres?sslmode=require
WORKER_DATABASE_URL=postgresql://herp_worker:<HERP_WORKER_DB_PASSWORD>@<db host>:5432/postgres?sslmode=require

# --- Secrets (generate each once; keep a sealed backup) ---------------------------------------
# openssl rand -base64 32      Losing AUTH_TOTP_KEY invalidates every authenticator enrolment.
AUTH_TOTP_KEY=
# openssl rand -hex 32   (three different values)
SESSION_SIGNING_SECRET=
FILE_SIGNING_SECRET=
OFFLINE_KEY_SECRET=

# --- Field encryption (Google Cloud KMS) -------------------------------------------------------
HERP_KMS_KEY=projects/<project>/locations/<location>/keyRings/<ring>/cryptoKeys/<key>
# Service-account JSON allowed to encrypt/decrypt with that key (chmod 600).
GCP_KMS_CREDENTIALS=./secrets/gcp-kms.json

# --- SMS / e-mail gateway for the first-time setup codes ---------------------------------------
OTP_WEBHOOK_URL=
OTP_WEBHOOK_TOKEN=

# --- Optional -----------------------------------------------------------------------------------
# Name in verification messages before a person belongs to a household.
AUTH_BRAND_NAME=Dar
# IMAGE_TAG=2026-11-10

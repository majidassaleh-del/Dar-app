# Prisma (schema.prisma reads both; validate/migrate need them set)
DATABASE_URL=postgresql://app_user@localhost:5432/herp
DIRECT_URL=postgresql://postgres@localhost:5432/herp
# Dev-only key-encryption key for LocalKmsProvider (32 random bytes, base64). Never set in production.
HERP_LOCAL_KEK=
# Production: Cloud KMS key used by GcpKmsProvider
HERP_KMS_KEY=projects/PROJECT/locations/me-central2/keyRings/herp/cryptoKeys/household-dek

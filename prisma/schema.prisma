  annualLeaveDays    Int       @default(15) // Art. 10: days accrued per year (statutory 15 = 30 per 2 years); contracts may grant more, never less
  ticketEntitlement  Boolean   @default(true) // home-country air ticket
  endOfServiceRule   String    @default("SA_DOMESTIC") // pluggable calc strategy
  workingHoursPerDay Int?
  isActive           Boolean   @default(true)
  signedAt           DateTime? @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @db.Timestamptz(6)

  household Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)

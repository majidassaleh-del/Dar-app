  amount          Decimal         @db.Decimal(18, 2) // negative for deductions
  advanceId       String?         @db.Uuid
  transactionId   String?         @unique @db.Uuid // ledger posting when paid

  household   Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)

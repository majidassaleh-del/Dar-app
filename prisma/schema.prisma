/// Chores / daily tasks assigned to staff or dependents.
model HouseholdTask {
  id            String               @id @default(uuid()) @db.Uuid
  householdId   String               @db.Uuid
  titleI18n     Json                 @default("{}") // auto-translated into assignee's locale
  description   String?
  assigneeId    String?              @db.Uuid
  createdById   String               @db.Uuid
  status        TaskStatus           @default(TODO)
  dueAt         DateTime?            @db.Timestamptz(6)
  recurrence    RecurrenceFrequency?
  completedAt   DateTime?            @db.Timestamptz(6)
  proofPhotoUrl String?
  createdAt     DateTime             @default(now()) @db.Timestamptz(6)
  /// Bumped by a DB trigger on every change: offline clients send it back as baseVersion.
  version       Int                  @default(1)
  updatedAt     DateTime             @default(now()) @db.Timestamptz(6)

  household Household   @relation(fields: [householdId], references: [id], onDelete: Cascade)
  assignee  Membership? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy Membership  @relation("TaskCreator", fields: [createdById], references: [id])

  @@index([householdId, assigneeId, status])
  @@index([householdId, updatedAt])
  @@map("household_tasks")
}

// =============================================================================
//  MODULE 2 — HOUSEHOLD ACCOUNTING
// =============================================================================

model FinancialAccount {
  id             String               @id @default(uuid()) @db.Uuid
  householdId    String               @db.Uuid
  type           FinancialAccountType
  nameI18n       Json                 @default("{}")
  institution    String? // bank name
  ibanLast4      String?              @db.VarChar(4)
  ibanCiphertext String? // KMS envelope
  ibanBlindIndex String? // HMAC lookup / dedupe
  currency       String               @default("SAR") @db.Char(3)
  openingBalance Decimal              @default(0) @db.Decimal(18, 2)
  currentBalance Decimal              @default(0) @db.Decimal(18, 2) // maintained by trigger / service
  custodianId    String?              @db.Uuid // e.g. driver holding petty cash
  bankFeedRef    String? // aggregator (Lean/Tarabut) connection id
  isActive       Boolean              @default(true)
  createdAt      DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime             @updatedAt @db.Timestamptz(6)

  household        Household             @relation(fields: [householdId], references: [id], onDelete: Cascade)
  custodian        Membership?           @relation("AccountCustodian", fields: [custodianId], references: [id], onDelete: SetNull)
  cards            Card[]
  transactions     Transaction[]         @relation("TxnAccount")
  transfersIn      Transaction[]         @relation("TxnCounterAccount")
  pettyCash        PettyCashAccount?
  ledgerAccount    LedgerAccount?
  statementImports BankStatementImport[]
  statementLines   BankStatementLine[]

  @@index([householdId, type])
  @@map("financial_accounts")
}

/// Physical/virtual cards issued to family members or staff.
model Card {
  id                 String     @id @default(uuid()) @db.Uuid
  householdId        String     @db.Uuid
  accountId          String     @db.Uuid
  holderId           String?    @db.Uuid
  type               CardType
  status             CardStatus @default(ACTIVE)
  nickname           String?
  last4              String     @db.VarChar(4) // NEVER store PAN/CVV (PCI-DSS)
  network            String? // mada, visa, mastercard
  expiryMonth        Int
  expiryYear         Int
  dailyLimit         Decimal?   @db.Decimal(18, 2)
  monthlyLimit       Decimal?   @db.Decimal(18, 2)
  perTxnLimit        Decimal?   @db.Decimal(18, 2)
  allowedCategoryIds String[]   @db.Uuid // MCC-style restriction for dependents/staff
  issuerToken        String?    @unique // tokenised reference at issuing partner
  createdAt          DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime   @updatedAt @db.Timestamptz(6)

  household    Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  account      FinancialAccount @relation(fields: [accountId], references: [id])
  holder       Membership?      @relation("CardHolder", fields: [holderId], references: [id], onDelete: SetNull)
  transactions Transaction[]

  @@index([householdId, holderId])
  @@map("cards")
}

model Category {
  id          String          @id @default(uuid()) @db.Uuid
  householdId String          @db.Uuid
  parentId    String?         @db.Uuid
  kind        TransactionType // EXPENSE or INCOME
  nameI18n    Json            @default("{}")
  icon        String?
  color       String?
  isSystem    Boolean         @default(false)
  sortOrder   Int             @default(0)

  household     Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  parent        Category?      @relation("CategoryTree", fields: [parentId], references: [id])
  children      Category[]     @relation("CategoryTree")
  transactions  Transaction[]
  budgets       Budget[]
  pettyCashLogs PettyCashLog[]
  ledgerAccount LedgerAccount?

  @@index([householdId, kind])
  @@map("categories")
}

/// Single-entry ledger with transfer pairing. Immutable once POSTED;
/// corrections are new REVERSED/ADJUSTMENT rows linked via `reversalOfId`.
model Transaction {
  id               String            @id @default(uuid()) @db.Uuid
  householdId      String            @db.Uuid
  accountId        String            @db.Uuid
  counterAccountId String?           @db.Uuid // for TRANSFER
  cardId           String?           @db.Uuid
  categoryId       String?           @db.Uuid
  type             TransactionType
  status           TransactionStatus @default(POSTED)
  source           TransactionSource @default(MANUAL)
  amount           Decimal           @db.Decimal(18, 2) // always positive; sign from type
  currency         String            @db.Char(3)
  fxRate           Decimal?          @db.Decimal(18, 8) // to household base currency
  baseAmount       Decimal           @db.Decimal(18, 2) // amount in base currency
  vatAmount        Decimal?          @db.Decimal(18, 2)
  merchantName     String?
  merchantMcc      String?           @db.VarChar(4)
  descriptionI18n  Json              @default("{}")
  occurredAt       DateTime          @db.Timestamptz(6)
  createdById      String            @db.Uuid
  spentById        String?           @db.Uuid // who actually spent (driver, child)
  requestId        String?           @db.Uuid
  vehicleId        String?           @db.Uuid // cost-centre tagging
  propertyId       String?           @db.Uuid
  reversalOfId     String?           @unique @db.Uuid
  externalRef      String? // bank txn id — dedupe; "recurring:<ruleId>:<date>" for recurring bills
  tags             String[]
  /// Owner funding outflow (cash withdrawn for a float, a salary transfer…): posts
  /// Dr 1190 Owner funding clearing / Cr bank, then is matched to clearing items.
  isFunding        Boolean           @default(false)
  recurringRuleId  String?           @db.Uuid
  reconciledAt     DateTime?         @db.Timestamptz(6)
  createdAt        DateTime          @default(now()) @db.Timestamptz(6)

  household      Household          @relation(fields: [householdId], references: [id], onDelete: Cascade)
  account        FinancialAccount   @relation("TxnAccount", fields: [accountId], references: [id])
  counterAccount FinancialAccount?  @relation("TxnCounterAccount", fields: [counterAccountId], references: [id])
  card           Card?              @relation(fields: [cardId], references: [id])
  category       Category?          @relation(fields: [categoryId], references: [id])
  createdBy      Membership         @relation("TxnCreatedBy", fields: [createdById], references: [id])
  spentBy        Membership?        @relation("TxnSpentBy", fields: [spentById], references: [id])
  request        Request?           @relation(fields: [requestId], references: [id])
  vehicle        Vehicle?           @relation(fields: [vehicleId], references: [id])
  property       Property?          @relation(fields: [propertyId], references: [id])
  reversalOf     Transaction?       @relation("Reversal", fields: [reversalOfId], references: [id])
  reversedBy     Transaction?       @relation("Reversal")
  receipts       Receipt[]
  payrollLine    PayrollLine?
  maintenance    MaintenanceRecord?
  fuelLog        FuelLog?
  fundingMatches FundingMatch[]
  recurringRule  RecurringRule?     @relation(fields: [recurringRuleId], references: [id], onDelete: SetNull)
  statementLine  BankStatementLine?
  rentPayment    RentPayment?
  utilityBill    UtilityBill?
  pettyCashLog   PettyCashLog?
  salaryPayment  SalaryPayment?
  tripBooking    TripBooking?

  @@unique([householdId, accountId, externalRef])
  @@index([householdId, occurredAt(sort: Desc)])
  @@index([householdId, categoryId, occurredAt])
  @@index([householdId, spentById, occurredAt])
  @@index([cardId])
  @@map("transactions")
}

/// Receipt images → OCR pipeline → suggested Transaction.
model Receipt {
  id            String        @id @default(uuid()) @db.Uuid
  householdId   String        @db.Uuid
  uploadedById  String        @db.Uuid
  transactionId String?       @db.Uuid
  status        ReceiptStatus @default(UPLOADED)
  storageKey    String // s3/supabase-storage object key
  mimeType      String
  sha256        String // duplicate detection
  ocrProvider   String? // textract | google-docai | claude-vision
  ocrRaw        Json?
  extracted     Json? // { merchant, date, total, vat, vatNumber, lineItems[] }
  confidence    Float?
  zatcaQr       String? // ZATCA e-invoice QR payload (TLV base64)
  createdAt     DateTime      @default(now()) @db.Timestamptz(6)
  processedAt   DateTime?     @db.Timestamptz(6)

  household    Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  uploadedBy   Membership    @relation(fields: [uploadedById], references: [id])
  transaction  Transaction?  @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  pettyCashLog PettyCashLog?
  fuelLog      FuelLog?

  @@unique([householdId, sha256])
  @@index([householdId, status])
  @@map("receipts")
}

model Budget {
  id          String       @id @default(uuid()) @db.Uuid
  householdId String       @db.Uuid
  categoryId  String?      @db.Uuid // null = overall
  ownerId     String?      @db.Uuid // personal budget (e.g. teen)
  nameI18n    Json         @default("{}")
  period      BudgetPeriod @default(MONTHLY)
  amount      Decimal      @db.Decimal(18, 2)
  currency    String       @default("SAR") @db.Char(3)
  alertAtPct  Int          @default(80)
  rollover    Boolean      @default(false)
  startsOn    DateTime     @db.Date
  endsOn      DateTime?    @db.Date

  household Household   @relation(fields: [householdId], references: [id], onDelete: Cascade)
  category  Category?   @relation(fields: [categoryId], references: [id])
  owner     Membership? @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([householdId, period])
  @@map("budgets")
}

/// Recurring bills, subscriptions, rent, salaries.
model RecurringRule {
  id          String              @id @default(uuid()) @db.Uuid
  householdId String              @db.Uuid
  template    Json // a Transaction-shaped payload
  frequency   RecurrenceFrequency
  interval    Int                 @default(1)
  dayOfPeriod Int?
  nextRunAt   DateTime            @db.Timestamptz(6)
  endsAt      DateTime?           @db.Timestamptz(6)
  autoPost    Boolean             @default(false) // false = create PENDING for review
  isActive    Boolean             @default(true)
  nameI18n    Json                @default("{}")
  createdById String              @db.Uuid // membership that set up the bill; recorded as the transactions' creator
  lastRunAt   DateTime?           @db.Timestamptz(6)

  household    Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([nextRunAt, isActive])
  @@map("recurring_rules")
}

/// Pocket money for dependents.
model AllowancePlan {
  id           String              @id @default(uuid()) @db.Uuid
  householdId  String              @db.Uuid
  dependentId  String              @db.Uuid
  amount       Decimal             @db.Decimal(18, 2)
  currency     String              @default("SAR") @db.Char(3)
  frequency    RecurrenceFrequency @default(WEEKLY)
  targetCardId String?             @db.Uuid
  savingsGoal  Decimal?            @db.Decimal(18, 2)
  savingsPct   Int                 @default(0) // auto-save portion
  nextPayoutAt DateTime            @db.Timestamptz(6)
  isActive     Boolean             @default(true)

  household Household  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  dependent Membership @relation(fields: [dependentId], references: [id], onDelete: Cascade)

  @@index([householdId, dependentId])
  @@map("allowance_plans")
}

// =============================================================================
//  CROSS-MODULE — REQUESTS & APPROVAL WORKFLOW
// =============================================================================

/// One generic request entity drives purchases, reimbursements, advances,
/// leave, allowance top-ups, vehicle use, maintenance. Type-specific data
/// goes in `payload` (validated by Zod schema per RequestType).
model Request {
  id             String          @id @default(uuid()) @db.Uuid
  householdId    String          @db.Uuid
  requesterId    String          @db.Uuid
  type           RequestType
  status         RequestStatus   @default(SUBMITTED)
  priority       RequestPriority @default(NORMAL)
  titleI18n      Json            @default("{}") // original + machine translation
  originalLocale Locale          @default(ar)
  payload        Json            @default("{}")
  amount         Decimal?        @db.Decimal(18, 2)
  currency       String?         @db.Char(3)
  neededBy       DateTime?       @db.Timestamptz(6)
  currentStep    Int             @default(1)
  resolvedAt     DateTime?       @db.Timestamptz(6)
  createdAt      DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(6)

  household    Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  requester    Membership     @relation("Requester", fields: [requesterId], references: [id])
  approvals    Approval[]
  transactions Transaction[]
  advance      SalaryAdvance?
  leave        LeaveRecord?
  workOrders   WorkOrder[]

  @@index([householdId, status, type])
  @@index([requesterId, createdAt(sort: Desc)])
  @@map("requests")
}

/// Configurable chains, e.g. PURCHASE > 500 SAR → Spouse then Head.
model ApprovalPolicy {
  id               String      @id @default(uuid()) @db.Uuid
  householdId      String      @db.Uuid
  requestType      RequestType
  minAmount        Decimal?    @db.Decimal(18, 2)
  maxAmount        Decimal?    @db.Decimal(18, 2)
  steps            Json // [{ step: 1, approverRole: "SPOUSE" | membershipId, anyOf: true }]
  autoApproveBelow Decimal?    @db.Decimal(18, 2)
  isActive         Boolean     @default(true)

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId, requestType])
  @@map("approval_policies")
}

model Approval {
  id          String           @id @default(uuid()) @db.Uuid
  householdId String           @db.Uuid
  requestId   String           @db.Uuid
  step        Int
  approverId  String           @db.Uuid
  decision    ApprovalDecision @default(PENDING)
  comment     String?
  decidedAt   DateTime?        @db.Timestamptz(6)

  household Household  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  request   Request    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  approver  Membership @relation("Approver", fields: [approverId], references: [id])

  @@unique([requestId, step, approverId])
  @@index([approverId, decision])
  @@map("approvals")
}

// =============================================================================
//  MODULE 3 — INVESTMENTS & ASSETS
// =============================================================================

model Portfolio {
  id                  String   @id @default(uuid()) @db.Uuid
  householdId         String   @db.Uuid
  nameI18n            Json     @default("{}")
  broker              String? // Al Rajhi Capital, Derayah, IBKR ...
  baseCurrency        String   @default("SAR") @db.Char(3)
  shariaCompliantOnly Boolean  @default(false)
  ownerLabel          String? // "Joint", "Ahmed's education fund"
  createdAt           DateTime @default(now()) @db.Timestamptz(6)

  household Household               @relation(fields: [householdId], references: [id], onDelete: Cascade)
  holdings  Holding[]
  txns      InvestmentTransaction[]

  @@index([householdId])
  @@map("portfolios")
}

/// Instrument or physical asset. Market instruments may be shared reference
/// data in a future version; kept tenant-scoped for privacy & simplicity.
model Asset {
  id                String     @id @default(uuid()) @db.Uuid
  householdId       String     @db.Uuid
  assetClass        AssetClass
  nameI18n          Json       @default("{}")
  symbol            String? // 2222.SR, AAPL, XAU
  exchange          String? // TADAWUL, NASDAQ
  isin              String?
  currency          String     @default("SAR") @db.Char(3)
  isShariaCompliant Boolean?
  propertyId        String?    @unique @db.Uuid // REAL_ESTATE links to Property
  metadata          Json       @default("{}") // karat & grams for gold, wallet for crypto
  zakatable         Boolean    @default(true)
  createdAt         DateTime   @default(now()) @db.Timestamptz(6)

  household  Household               @relation(fields: [householdId], references: [id], onDelete: Cascade)
  property   Property?               @relation(fields: [propertyId], references: [id])
  holdings   Holding[]
  txns       InvestmentTransaction[]
  valuations AssetValuation[]

  @@unique([householdId, symbol, exchange])
  @@index([householdId, assetClass])
  @@map("assets")
}

/// Current position (materialised from InvestmentTransaction).
model Holding {
  id          String   @id @default(uuid()) @db.Uuid
  householdId String   @db.Uuid
  portfolioId String   @db.Uuid
  assetId     String   @db.Uuid
  quantity    Decimal  @db.Decimal(24, 8)
  avgCost     Decimal  @db.Decimal(24, 8)
  costBasis   Decimal  @db.Decimal(18, 2)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  asset     Asset     @relation(fields: [assetId], references: [id])

  @@unique([portfolioId, assetId])
  @@map("holdings")
}

model InvestmentTransaction {
  id                 String            @id @default(uuid()) @db.Uuid
  householdId        String            @db.Uuid
  portfolioId        String            @db.Uuid
  assetId            String            @db.Uuid
  type               InvestmentTxnType
  quantity           Decimal?          @db.Decimal(24, 8)
  price              Decimal?          @db.Decimal(24, 8)
  amount             Decimal           @db.Decimal(18, 2)
  fees               Decimal           @default(0) @db.Decimal(18, 2)
  currency           String            @db.Char(3)
  fxRate             Decimal?          @db.Decimal(18, 8)
  tradeDate          DateTime          @db.Date
  purificationAmount Decimal?          @db.Decimal(18, 2) // Sharia income purification
  notes              String?
  createdAt          DateTime          @default(now()) @db.Timestamptz(6)

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  asset     Asset     @relation(fields: [assetId], references: [id])

  @@index([householdId, tradeDate])
  @@index([portfolioId, assetId])
  @@map("investment_transactions")
}

/// Time series of prices / appraisals (partition by month at scale).
model AssetValuation {
  id          String          @id @default(uuid()) @db.Uuid
  householdId String          @db.Uuid
  assetId     String          @db.Uuid
  asOf        DateTime        @db.Timestamptz(6)
  unitValue   Decimal         @db.Decimal(24, 8)
  currency    String          @db.Char(3)
  source      ValuationSource @default(MARKET_FEED)

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  asset     Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, asOf, source])
  @@map("asset_valuations")
}

// =============================================================================
//  MODULE 4a — VEHICLE FLEET
// =============================================================================

model Vehicle {
  id                 String        @id @default(uuid()) @db.Uuid
  householdId        String        @db.Uuid
  make               String
  model              String
  year               Int
  color              String?
  plateNumber        String
  plateNumberAr      String? // Arabic letters on GCC plates
  vin                String?
  fuelType           FuelType      @default(PETROL_91)
  status             VehicleStatus @default(ACTIVE)
  ownership          OwnershipType @default(OWNED)
  leaseContractRef   String?
  odometerKm         Int           @default(0)
  registrationExpiry DateTime?     @db.Date // Istimara
  insuranceExpiry    DateTime?     @db.Date
  insurancePolicy    String?
  inspectionExpiry   DateTime?     @db.Date // Fahas
  registrationNumber String? // Istimara serial
  insuranceProvider  String?
  lastInspectionAt   DateTime?     @db.Date
  inspectionCenter   String?
  tankCapacityL      Decimal?      @db.Decimal(6, 1)
  expectedKmPerL     Decimal?      @db.Decimal(5, 2) // baseline for fuel anomaly checks; else the rolling average
  purchasePrice      Decimal?      @db.Decimal(18, 2)
  purchaseDate       DateTime?     @db.Date
  telematicsId       String? // GPS tracker device id
  createdAt          DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime      @updatedAt @db.Timestamptz(6)
  deletedAt          DateTime?     @db.Timestamptz(6)

  household     Household           @relation(fields: [householdId], references: [id], onDelete: Cascade)
  assignments   VehicleAssignment[]
  maintenance   MaintenanceRecord[]
  fuelLogs      FuelLog[]
  violations    TrafficViolation[]
  trips         TripLog[]
  transactions  Transaction[]
  workOrders    WorkOrder[]
  pettyCashLogs PettyCashLog[]
  plans         MaintenancePlan[]
  odometer      OdometerReading[]

  @@unique([householdId, plateNumber])
  @@index([householdId, status])
  @@map("vehicles")
}

model VehicleAssignment {
  id            String    @id @default(uuid()) @db.Uuid
  householdId   String    @db.Uuid
  vehicleId     String    @db.Uuid
  driverId      String    @db.Uuid // membership (driver or family member)
  isPrimary     Boolean   @default(true)
  startsAt      DateTime  @db.Timestamptz(6)
  endsAt        DateTime? @db.Timestamptz(6)
  startOdometer Int?
  endOdometer   Int?

  household Household  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  vehicle   Vehicle    @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driver    Membership @relation(fields: [driverId], references: [id])

  @@index([vehicleId, startsAt])
  @@index([driverId, endsAt])
  @@map("vehicle_assignments")
}

model MaintenanceRecord {
  id            String            @id @default(uuid()) @db.Uuid
  householdId   String            @db.Uuid
  vehicleId     String            @db.Uuid
  type          MaintenanceType
  status        MaintenanceStatus @default(SCHEDULED)
  workshop      String?
  scheduledAt   DateTime?         @db.Timestamptz(6)
  completedAt   DateTime?         @db.Timestamptz(6)
  odometerKm    Int?
  nextDueKm     Int?
  nextDueDate   DateTime?         @db.Date
  cost          Decimal?          @db.Decimal(18, 2)
  currency      String            @default("SAR") @db.Char(3)
  notes         String?
  transactionId String?           @unique @db.Uuid
  planId        String?           @db.Uuid

  household   Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  vehicle     Vehicle          @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  transaction Transaction?     @relation(fields: [transactionId], references: [id])
  plan        MaintenancePlan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([vehicleId, scheduledAt])
  @@index([householdId, nextDueDate])
  @@map("maintenance_records")
}

model FuelLog {
  id             String    @id @default(uuid()) @db.Uuid
  householdId    String    @db.Uuid
  vehicleId      String    @db.Uuid
  filledAt       DateTime  @db.Timestamptz(6)
  liters         Decimal   @db.Decimal(10, 2)
  pricePerLiter  Decimal   @db.Decimal(10, 3)
  totalCost      Decimal   @db.Decimal(18, 2)
  odometerKm     Int
  station        String?
  transactionId  String?   @unique @db.Uuid
  driverId       String?   @db.Uuid // membership that filled up
  receiptId      String?   @unique @db.Uuid
  pettyCashLogId String?   @unique @db.Uuid // paid from the driver's float
  fuelType       FuelType?
  kmSinceLast    Int? // distance since the previous fill (set by trigger)
  kmPerL         Decimal?  @db.Decimal(6, 2) // kmSinceLast / liters of THIS fill (full-to-full)
  anomalies      Json      @default("[]") // [{ code, message, severity }]
  flagged        Boolean   @default(false)

  household    Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  vehicle      Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  transaction  Transaction?  @relation(fields: [transactionId], references: [id])
  driver       Membership?   @relation("FuelDriver", fields: [driverId], references: [id], onDelete: SetNull)
  receipt      Receipt?      @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  pettyCashLog PettyCashLog? @relation(fields: [pettyCashLogId], references: [id], onDelete: SetNull)

  @@index([vehicleId, filledAt])
  @@map("fuel_logs")
}

enum OdometerSource {
  MANUAL
  FUEL
  TRIP
  SERVICE
}

/// Preventive maintenance on a km and/or day interval (oil change every 10,000 km or 6 months,
/// tyre rotation, periodic inspection). Next due date / km are kept by a trigger from the
/// last COMPLETED service linked to the plan.
model MaintenancePlan {
  id           String          @id @default(uuid()) @db.Uuid
  householdId  String          @db.Uuid
  vehicleId    String          @db.Uuid
  type         MaintenanceType
  titleI18n    Json            @default("{}")
  intervalKm   Int?
  intervalDays Int?
  lastDoneAt   DateTime?       @db.Date
  lastDoneKm   Int?
  nextDueDate  DateTime?       @db.Date
  nextDueKm    Int?
  /// When the odometer first came within the km warning window (alert anchor; cleared on service).
  kmAlertAt    DateTime?       @db.Timestamptz(6)
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime        @default(now()) @db.Timestamptz(6)

  household Household           @relation(fields: [householdId], references: [id], onDelete: Cascade)
  vehicle   Vehicle             @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  records   MaintenanceRecord[]

  @@unique([vehicleId, type])
  @@index([householdId, nextDueDate])
  @@map("maintenance_plans")
}

/// Mileage history. Readings never go backwards (DB trigger); the vehicle's odometerKm follows the maximum.
model OdometerReading {
  id           String         @id @default(uuid()) @db.Uuid
  householdId  String         @db.Uuid
  vehicleId    String         @db.Uuid
  readingKm    Int
  readAt       DateTime       @default(now()) @db.Timestamptz(6)
  source       OdometerSource @default(MANUAL)
  recordedById String         @db.Uuid
  note         String?
  createdAt    DateTime       @default(now()) @db.Timestamptz(6)

  household  Household  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  vehicle    Vehicle    @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  recordedBy Membership @relation(fields: [recordedById], references: [id])

  @@index([vehicleId, readAt])
  @@map("odometer_readings")
}

model TrafficViolation {
  id              String          @id @default(uuid()) @db.Uuid
  householdId     String          @db.Uuid
  vehicleId       String          @db.Uuid
  staffId         String?         @db.Uuid // responsible driver
  violationNo     String // e.g. from Absher/Saher
  occurredAt      DateTime        @db.Timestamptz(6)
  descriptionI18n Json            @default("{}")
  location        String?
  amount          Decimal         @db.Decimal(18, 2)
  status          ViolationStatus @default(UNPAID)
  dueDate         DateTime?       @db.Date

  household Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  vehicle   Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  staff     StaffProfile? @relation(fields: [staffId], references: [id])

  @@unique([householdId, violationNo])
  @@map("traffic_violations")
}

/// School runs, errands — driver logs trips from the mobile app.
model TripLog {
  id          String    @id @default(uuid()) @db.Uuid
  householdId String    @db.Uuid
  vehicleId   String    @db.Uuid
  driverId    String    @db.Uuid
  purpose     String? // school_run, groceries, airport
  passengers  String[]  @db.Uuid // membership ids
  startedAt   DateTime  @db.Timestamptz(6)
  endedAt     DateTime? @db.Timestamptz(6)
  startKm     Int?
  endKm       Int?
  route       Json? // simplified polyline (opt-in)

  household Household  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  vehicle   Vehicle    @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driver    Membership @relation(fields: [driverId], references: [id])

  @@index([vehicleId, startedAt])
  @@map("trip_logs")
}

// =============================================================================
//  MODULE 4b — PROPERTY MANAGEMENT
// =============================================================================

model Property {
  id                   String        @id @default(uuid()) @db.Uuid
  householdId          String        @db.Uuid
  nameI18n             Json          @default("{}")
  type                 PropertyType
  usage                PropertyUsage @default(PRIMARY_RESIDENCE)
  addressI18n          Json          @default("{}")
  nationalAddress      String? // SA short address e.g. RRRD2929
  city                 String?
  geo                  Json? // { lat, lng }
  deedNumber           String? // sakk
  areaSqm              Decimal?      @db.Decimal(12, 2)
  purchasePrice        Decimal?      @db.Decimal(18, 2)
  purchaseDate         DateTime?     @db.Date
  electricityAccountNo String?
  waterAccountNo       String?
  createdAt            DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime      @updatedAt @db.Timestamptz(6)
  deletedAt            DateTime?     @db.Timestamptz(6)

  household    Household           @relation(fields: [householdId], references: [id], onDelete: Cascade)
  units        PropertyUnit[]
  bills        UtilityBill[]
  tickets      MaintenanceTicket[]
  transactions Transaction[]
  asset        Asset?
  workOrders   WorkOrder[]

  @@index([householdId, usage])
  @@map("properties")
}

model PropertyUnit {
  id           String   @id @default(uuid()) @db.Uuid
  householdId  String   @db.Uuid
  propertyId   String   @db.Uuid
  label        String // "1st floor", "Roof annex", "Apt 3"
  bedrooms     Int?
  areaSqm      Decimal? @db.Decimal(12, 2)
  meterNumbers Json     @default("{}") // { electricity: "...", water: "..." } sub-meters
  isOccupied   Boolean  @default(false)

  household  Household           @relation(fields: [householdId], references: [id], onDelete: Cascade)
  property   Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  leases     Lease[]
  bills      UtilityBill[]
  tickets    MaintenanceTicket[]
  workOrders WorkOrder[]

  @@unique([propertyId, label])
  @@map("property_units")
}

/// Household as landlord (renting out) OR as lessee (renting in): `direction`.
model Lease {
  id                       String              @id @default(uuid()) @db.Uuid
  householdId              String              @db.Uuid
  unitId                   String              @db.Uuid
  direction                String              @default("LANDLORD") // LANDLORD | LESSEE
  counterpartyName         String
  counterpartyPhone        String?
  counterpartyIdCiphertext String? // KMS envelope (national ID / iqama of tenant or landlord)
  ejarContractNo           String? // Saudi Ejar platform
  startDate                DateTime            @db.Date
  endDate                  DateTime            @db.Date
  rentAmount               Decimal             @db.Decimal(18, 2)
  currency                 String              @default("SAR") @db.Char(3)
  paymentFrequency         RecurrenceFrequency @default(QUARTERLY)
  securityDeposit          Decimal?            @db.Decimal(18, 2)
  utilitiesIncluded        Boolean             @default(false)
  status                   LeaseStatus         @default(ACTIVE)
  hijriDated               Boolean             @default(false)

  household Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  unit      PropertyUnit  @relation(fields: [unitId], references: [id], onDelete: Cascade)
  payments  RentPayment[]

  @@index([householdId, status, endDate])
  @@map("leases")
}

model RentPayment {
  id            String    @id @default(uuid()) @db.Uuid
  householdId   String    @db.Uuid
  leaseId       String    @db.Uuid
  dueDate       DateTime  @db.Date
  hijriDueDate  String? // e.g. "1448-06-15" when lease is Hijri-dated
  amountDue     Decimal   @db.Decimal(18, 2)
  amountPaid    Decimal   @default(0) @db.Decimal(18, 2)
  paidAt        DateTime? @db.Timestamptz(6)
  transactionId String?   @unique @db.Uuid

  household   Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  lease       Lease        @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id])

  @@unique([leaseId, dueDate])
  @@index([householdId, dueDate])
  @@map("rent_payments")
}

/// Utility bills, with optional split across units (sub-metering).
model UtilityBill {
  id            String    @id @default(uuid()) @db.Uuid
  householdId   String    @db.Uuid
  propertyId    String    @db.Uuid
  unitId        String?   @db.Uuid
  type          BillType
  provider      String? // SEC, NWC, STC
  accountNo     String?
  periodStart   DateTime  @db.Date
  periodEnd     DateTime  @db.Date
  consumption   Decimal?  @db.Decimal(14, 3) // kWh / m³
  amount        Decimal   @db.Decimal(18, 2)
  dueDate       DateTime? @db.Date
  paidAt        DateTime? @db.Timestamptz(6)
  allocation    Json? // [{ unitId, share, amount }] for split billing
  transactionId String?   @unique @db.Uuid

  household   Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  property    Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unit        PropertyUnit? @relation(fields: [unitId], references: [id])
  transaction Transaction?  @relation(fields: [transactionId], references: [id])

  @@index([propertyId, periodStart])
  @@map("utility_bills")
}

model MaintenanceTicket {
  id            String          @id @default(uuid()) @db.Uuid
  householdId   String          @db.Uuid
  propertyId    String          @db.Uuid
  unitId        String?         @db.Uuid
  reporterId    String          @db.Uuid
  assigneeId    String?         @db.Uuid
  titleI18n     Json            @default("{}")
  category      String? // plumbing, AC, electrical, pest
  priority      RequestPriority @default(NORMAL)
  status        TicketStatus    @default(OPEN)
  vendor        String?
  estimatedCost Decimal?        @db.Decimal(18, 2)
  actualCost    Decimal?        @db.Decimal(18, 2)
  openedAt      DateTime        @default(now()) @db.Timestamptz(6)
  resolvedAt    DateTime?       @db.Timestamptz(6)

  household Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  property  Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unit      PropertyUnit? @relation(fields: [unitId], references: [id])
  reporter  Membership    @relation("TicketReporter", fields: [reporterId], references: [id])
  assignee  Membership?   @relation("TicketAssignee", fields: [assigneeId], references: [id])
  workOrder WorkOrder?

  @@index([householdId, status])
  @@map("maintenance_tickets")
}

// =============================================================================
//  MODULE 5 — HR GOVERNANCE & POLICY (ZenHR / Jisr-style)
// -----------------------------------------------------------------------------
//  Policy            : job-specific standing / daily instructions, versioned.
//  CodeOfEthics      : one household-wide code, versioned.
//  PrivacyAgreement  : PDPL-grade NDA, surveillance (CCTV/GPS) and data-
//                      processing terms, with lawful basis, purposes, retention.
//  PolicyAcknowledgment : ONE evidence ledger for all three document kinds.
//                      Stores the exact language shown and a SHA-256 of the
//                      exact text, so "I agreed to X in Tagalog on date D" is
//                      provable. Rows are never deleted; consent is withdrawn
//                      by setting withdrawnAt (PDPL right to withdraw).
// =============================================================================

enum DocumentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AcknowledgmentFrequency {
  ONCE // once, ever
  ON_EACH_VERSION // again whenever a new version is published
  DAILY // e.g. driver pre-trip safety checklist
  SHIFT_START
}

enum AcknowledgmentMethod {
  TAP_TO_ACCEPT
  TYPED_NAME
  DRAWN_SIGNATURE
  OTP_CONFIRMED
  VERBAL_WITNESSED // read aloud for low-literacy staff; witness recorded
}

enum AgreementType {
  NON_DISCLOSURE
  SURVEILLANCE_CONSENT // CCTV, dash-cam, GPS
  DATA_PROCESSING_CONSENT // PDPL processing of the staff member's own data
  CHILD_PRIVACY // nannies: no photos/posting of children
  SOCIAL_MEDIA
}

enum LawfulBasis {
  CONSENT
  CONTRACT
  LEGAL_OBLIGATION
  LEGITIMATE_INTEREST
  VITAL_INTEREST
}

model Policy {
  id              String                  @id @default(uuid()) @db.Uuid
  householdId     String                  @db.Uuid
  code            String // stable key, e.g. "DRIVER-DAILY-SAFETY"
  version         Int                     @default(1)
  status          DocumentStatus          @default(DRAFT)
  staffTypes      StaffType[] // audience; empty = all staff
  titleI18n       Json                    @default("{}")
  bodyI18n        Json                    @default("{}") // markdown per locale
  originalLocale  Locale                  @default(ar)
  translationMeta Json                    @default("{}") // { "tl": { status, engine, reviewedBy, at } }
  ackFrequency    AcknowledgmentFrequency @default(ON_EACH_VERSION)
  effectiveFrom   DateTime                @db.Date
  effectiveTo     DateTime?               @db.Date
  contentHash     String? // sha256 of bodyI18n frozen at publish
  createdById     String                  @db.Uuid // audit reference
  publishedAt     DateTime?               @db.Timestamptz(6)
  createdAt       DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime                @updatedAt @db.Timestamptz(6)

  household       Household              @relation(fields: [householdId], references: [id], onDelete: Cascade)
  acknowledgments PolicyAcknowledgment[]

  @@unique([householdId, code, version])
  @@index([householdId, status])
  @@map("policies")
}

model CodeOfEthics {
  id              String         @id @default(uuid()) @db.Uuid
  householdId     String         @db.Uuid
  version         Int            @default(1)
  status          DocumentStatus @default(DRAFT)
  appliesToRoles  SystemRole[]   @default([STAFF, DRIVER])
  titleI18n       Json           @default("{}")
  bodyI18n        Json           @default("{}")
  originalLocale  Locale         @default(ar)
  translationMeta Json           @default("{}")
  effectiveFrom   DateTime       @db.Date
  contentHash     String?
  createdById     String         @db.Uuid
  publishedAt     DateTime?      @db.Timestamptz(6)
  createdAt       DateTime       @default(now()) @db.Timestamptz(6)

  household       Household              @relation(fields: [householdId], references: [id], onDelete: Cascade)
  acknowledgments PolicyAcknowledgment[]

  @@unique([householdId, version])
  @@map("codes_of_ethics")
}

model PrivacyAgreement {
  id                String         @id @default(uuid()) @db.Uuid
  householdId       String         @db.Uuid
  type              AgreementType
  version           Int            @default(1)
  status            DocumentStatus @default(DRAFT)
  appliesToRoles    SystemRole[]   @default([STAFF, DRIVER])
  titleI18n         Json           @default("{}")
  bodyI18n          Json           @default("{}")
  originalLocale    Locale         @default(ar)
  translationMeta   Json           @default("{}")
  lawfulBasis       LawfulBasis    @default(CONSENT)
  purposesI18n      Json           @default("{}") // why the data is processed, in plain language
  dataCategories    String[] // e.g. cctv_video, gps_location, phone_number
  /// { cctvZones: ["entrance","kitchen"], excludedZones: ["staff_quarters","bathrooms"],
  ///   gps: "on-duty hours only", audio: false } — private spaces must be listed as excluded.
  surveillanceScope Json?
  retentionDays     Int            @default(30)
  withdrawable      Boolean        @default(true) // false only for CONTRACT / LEGAL_OBLIGATION bases
  effectiveFrom     DateTime       @db.Date
  contentHash       String?
  createdById       String         @db.Uuid
  publishedAt       DateTime?      @db.Timestamptz(6)
  createdAt         DateTime       @default(now()) @db.Timestamptz(6)

  household       Household              @relation(fields: [householdId], references: [id], onDelete: Cascade)
  acknowledgments PolicyAcknowledgment[]

  @@unique([householdId, type, version])
  @@map("privacy_agreements")
}

/// Exactly one of policyId / codeOfEthicsId / privacyAgreementId is set
/// (CHECK constraint in migration 0002).
model PolicyAcknowledgment {
  id                  String               @id @default(uuid()) @db.Uuid
  householdId         String               @db.Uuid
  membershipId        String               @db.Uuid // the signer
  policyId            String?              @db.Uuid
  codeOfEthicsId      String?              @db.Uuid
  privacyAgreementId  String?              @db.Uuid
  documentVersion     Int
  contentHash         String // sha256 of the exact text rendered to the signer
  locale              Locale // language the signer actually read
  method              AcknowledgmentMethod @default(TAP_TO_ACCEPT)
  typedName           String?
  signatureStorageKey String?
  witnessId           String?              @db.Uuid
  ackDate             DateTime             @default(dbgenerated("CURRENT_DATE")) @db.Date
  acknowledgedAt      DateTime             @default(now()) @db.Timestamptz(6)
  deviceInfo          Json?
  ip                  String?              @db.Inet
  withdrawnAt         DateTime?            @db.Timestamptz(6)
  withdrawalReason    String?

  household        Household         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  signer           Membership        @relation("AckSigner", fields: [membershipId], references: [id])
  witness          Membership?       @relation("AckWitness", fields: [witnessId], references: [id])
  policy           Policy?           @relation(fields: [policyId], references: [id])
  codeOfEthics     CodeOfEthics?     @relation(fields: [codeOfEthicsId], references: [id])
  privacyAgreement PrivacyAgreement? @relation(fields: [privacyAgreementId], references: [id])

  // NULLs are distinct in Postgres, so this only bites policy rows: one per signer/version/day.
  @@unique([membershipId, policyId, documentVersion, ackDate])
  @@index([householdId, membershipId])
  @@index([privacyAgreementId, withdrawnAt])
  @@map("policy_acknowledgments")
}

// =============================================================================
//  MODULE 6 — PETTY CASH (daily driver / staff floats, imprest model)
// -----------------------------------------------------------------------------
//  Balance is maintained by a DB trigger (prisma/rls.sql) under a row lock:
//  TOP_UP +, EXPENSE −, RETURN −, ADJUSTMENT ± (only type allowed negative).
//  Logs are immutable apart from review fields. A REJECTED expense still
//  reduces cash (the money is gone) — recovery is a payroll deduction.
// =============================================================================

enum PettyCashLogType {
  TOP_UP
  EXPENSE
  RETURN
  ADJUSTMENT
}

enum PettyCashLogStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

model PettyCashAccount {
  id                  String    @id @default(uuid()) @db.Uuid
  householdId         String    @db.Uuid
  custodianId         String    @db.Uuid // driver / housekeeper holding the cash
  financialAccountId  String?   @unique @db.Uuid // optional ledger mirror (CASH_BOX)
  nameI18n            Json      @default("{}")
  currency            String    @default("SAR") @db.Char(3)
  floatLimit          Decimal   @db.Decimal(18, 2) // imprest amount
  currentBalance      Decimal   @default(0) @db.Decimal(18, 2) // trigger-maintained
  lowBalanceAlert     Decimal?  @db.Decimal(18, 2)
  receiptRequiredOver Decimal   @default(0) @db.Decimal(18, 2)
  allowNegative       Boolean   @default(false)
  isActive            Boolean   @default(true)
  lastReconciledAt    DateTime? @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(6)

  household        Household         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  custodian        Membership        @relation("PettyCashCustodian", fields: [custodianId], references: [id])
  financialAccount FinancialAccount? @relation(fields: [financialAccountId], references: [id])
  logs             PettyCashLog[]
  ledgerAccount    LedgerAccount?

  @@index([householdId, custodianId])
  @@map("petty_cash_accounts")
}

model PettyCashLog {
  id              String             @id @default(uuid()) @db.Uuid
  householdId     String             @db.Uuid
  accountId       String             @db.Uuid
  type            PettyCashLogType
  status          PettyCashLogStatus @default(APPROVED)
  amount          Decimal            @db.Decimal(18, 2)
  balanceAfter    Decimal            @default(0) @db.Decimal(18, 2) // set by trigger
  categoryId      String?            @db.Uuid
  descriptionI18n Json               @default("{}")
  originalLocale  Locale             @default(ar)
  merchantName    String?
  receiptId       String?            @unique @db.Uuid
  transactionId   String?            @unique @db.Uuid
  vehicleId       String?            @db.Uuid
  workOrderId     String?            @db.Uuid
  tripId          String?            @db.Uuid
  recordedById    String             @db.Uuid
  reviewedById    String?            @db.Uuid
  reviewedAt      DateTime?          @db.Timestamptz(6)
  occurredAt      DateTime           @default(now()) @db.Timestamptz(6)
  geo             Json?
  createdAt       DateTime           @default(now()) @db.Timestamptz(6)

  household   Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  account     PettyCashAccount @relation(fields: [accountId], references: [id])
  category    Category?        @relation(fields: [categoryId], references: [id])
  receipt     Receipt?         @relation(fields: [receiptId], references: [id])
  transaction Transaction?     @relation(fields: [transactionId], references: [id])
  vehicle     Vehicle?         @relation(fields: [vehicleId], references: [id])
  workOrder   WorkOrder?       @relation(fields: [workOrderId], references: [id])
  trip        Trip?            @relation(fields: [tripId], references: [id])
  recordedBy  Membership       @relation("PettyCashRecorder", fields: [recordedById], references: [id])
  fuelLog     FuelLog?

  @@index([accountId, occurredAt(sort: Desc)])
  @@index([householdId, status])
  @@map("petty_cash_logs")
}

// =============================================================================
//  MODULE 7 — WORK ORDERS (multilingual ticketing for staff & vendors)
// -----------------------------------------------------------------------------
//  Broader than MaintenanceTicket: any job ("prepare majlis for 20 guests",
//  "school pickup 13:30", "fix kitchen tap"). A ticket can spawn one work
//  order. Each instruction is stored in its original language and machine-
//  translated into the assignee's locale; isSafetyCritical instructions
//  (allergies, medication, child safety) need HUMAN_REVIEWED translation
//  before the order may leave NEW status (enforced by trigger).
// =============================================================================

enum WorkOrderStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  VERIFIED
  CANCELLED
}

enum WorkOrderCategory {
  CLEANING
  COOKING
  CHILDCARE
  DRIVING
  ERRAND
  GARDENING
  MAINTENANCE
  EVENT_PREP
  OTHER
}

enum TranslationStatus {
  ORIGINAL_ONLY
  PENDING
  MACHINE_TRANSLATED
  HUMAN_REVIEWED
  FAILED
}

model WorkOrder {
  id                  String               @id @default(uuid()) @db.Uuid
  householdId         String               @db.Uuid
  number              Int                  @default(0) // per-household sequence, set by trigger (WO-0001)
  titleI18n           Json                 @default("{}")
  descriptionI18n     Json                 @default("{}")
  originalLocale      Locale               @default(ar)
  category            WorkOrderCategory    @default(OTHER)
  priority            RequestPriority      @default(NORMAL)
  status              WorkOrderStatus      @default(NEW)
  requesterId         String               @db.Uuid
  assigneeId          String?              @db.Uuid
  assigneeStaffType   StaffType? // pool assignment: "any driver"
  vendorName          String?
  propertyId          String?              @db.Uuid
  unitId              String?              @db.Uuid
  vehicleId           String?              @db.Uuid
  maintenanceTicketId String?              @unique @db.Uuid
  requestId           String?              @db.Uuid
  tripId              String?              @db.Uuid
  scheduledAt         DateTime?            @db.Timestamptz(6)
  dueAt               DateTime?            @db.Timestamptz(6)
  startedAt           DateTime?            @db.Timestamptz(6)
  completedAt         DateTime?            @db.Timestamptz(6)
  verifiedAt          DateTime?            @db.Timestamptz(6)
  verifiedById        String?              @db.Uuid
  recurrence          RecurrenceFrequency?
  requiresPhotoProof  Boolean              @default(false)
  estimatedCost       Decimal?             @db.Decimal(18, 2)
  actualCost          Decimal?             @db.Decimal(18, 2)
  currency            String               @default("SAR") @db.Char(3)
  rating              Int? // 1..5 by requester on verification
  createdAt           DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @db.Timestamptz(6)
  deletedAt           DateTime?            @db.Timestamptz(6)

  household         Household              @relation(fields: [householdId], references: [id], onDelete: Cascade)
  requester         Membership             @relation("WorkOrderRequester", fields: [requesterId], references: [id])
  assignee          Membership?            @relation("WorkOrderAssignee", fields: [assigneeId], references: [id])
  property          Property?              @relation(fields: [propertyId], references: [id])
  unit              PropertyUnit?          @relation(fields: [unitId], references: [id])
  vehicle           Vehicle?               @relation(fields: [vehicleId], references: [id])
  maintenanceTicket MaintenanceTicket?     @relation(fields: [maintenanceTicketId], references: [id])
  request           Request?               @relation(fields: [requestId], references: [id])
  trip              Trip?                  @relation(fields: [tripId], references: [id])
  instructions      WorkOrderInstruction[]
  pettyCashLogs     PettyCashLog[]

  @@unique([householdId, number])
  @@index([householdId, status, priority])
  @@index([assigneeId, status])
  @@map("work_orders")
}

model WorkOrderInstruction {
  id                String            @id @default(uuid()) @db.Uuid
  householdId       String            @db.Uuid
  workOrderId       String            @db.Uuid
  sequence          Int
  textI18n          Json              @default("{}") // { "ar": original, "tl": translated, ... }
  originalLocale    Locale            @default(ar)
  translationStatus TranslationStatus @default(PENDING)
  translationMeta   Json              @default("{}") // per locale: { engine, confidence, reviewedById, at }
  isSafetyCritical  Boolean           @default(false)
  requiresPhoto     Boolean           @default(false)
  completedAt       DateTime?         @db.Timestamptz(6)
  completedById     String?           @db.Uuid
  photoStorageKey   String?
  note              String?

  version   Int      @default(1)
  updatedAt DateTime @default(now()) @db.Timestamptz(6)

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@unique([workOrderId, sequence])
  @@index([householdId, updatedAt])
  @@map("work_order_instructions")
}

// =============================================================================
//  MODULE 8 — FAMILY TRAVEL (itineraries, passengers, bookings)
// -----------------------------------------------------------------------------
//  Not to be confused with TripLog (a single vehicle journey).
//  Staff travelling with the family (nanny, driver) are passengers linked to
//  their StaffProfile + passport, so the expiry engine can warn about
//  passport validity and exit/re-entry visas before departure.
// =============================================================================

enum TravelTripStatus {
  PLANNING
  BOOKED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PassengerType {
  ADULT
  CHILD
  INFANT
}

enum VisaStatus {
  NOT_REQUIRED
  REQUIRED
  APPLIED
  GRANTED
  REFUSED
}

enum BookingType {
  FLIGHT
  HOTEL
  CAR_RENTAL
  TRAIN
  TRANSFER
  ACTIVITY
  TRAVEL_INSURANCE
  VISA
  OTHER
}

enum BookingStatus {
  HOLD
  CONFIRMED
  TICKETED
  CHECKED_IN
  CANCELLED
  REFUNDED
}

model Trip {
  id           String           @id @default(uuid()) @db.Uuid
  householdId  String           @db.Uuid
  organizerId  String           @db.Uuid
  titleI18n    Json             @default("{}")
  purpose      String? // vacation, umrah, medical, school, business
  status       TravelTripStatus @default(PLANNING)
  startDate    DateTime         @db.Date
  endDate      DateTime         @db.Date
  destinations Json             @default("[]") // [{ city, country, from, to }]
  budget       Decimal?         @db.Decimal(18, 2)
  currency     String           @default("SAR") @db.Char(3)
  notes        String?
  createdAt    DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @db.Timestamptz(6)

  household     Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  organizer     Membership      @relation(fields: [organizerId], references: [id])
  passengers    TripPassenger[]
  bookings      TripBooking[]
  workOrders    WorkOrder[]
  pettyCashLogs PettyCashLog[]

  @@index([householdId, startDate])
  @@map("trips")
}

/// One of membershipId / staffId / guestNameI18n must be set (CHECK in migration 0002).
model TripPassenger {
  id                  String        @id @default(uuid()) @db.Uuid
  householdId         String        @db.Uuid
  tripId              String        @db.Uuid
  membershipId        String?       @db.Uuid
  staffId             String?       @db.Uuid
  guestNameI18n       Json?
  passengerType       PassengerType @default(ADULT)
  passportDocumentId  String?       @db.Uuid
  visaStatus          VisaStatus    @default(NOT_REQUIRED)
  exitReentryRequired Boolean       @default(false)
  specialNeeds        String? // wheelchair, infant bassinet, dietary
  seatPreference      String?

  household Household         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  trip      Trip              @relation(fields: [tripId], references: [id], onDelete: Cascade)
  member    Membership?       @relation(fields: [membershipId], references: [id])
  staff     StaffProfile?     @relation(fields: [staffId], references: [id])
  passport  IdentityDocument? @relation(fields: [passportDocumentId], references: [id])

  @@unique([tripId, membershipId])
  @@unique([tripId, staffId])
  @@map("trip_passengers")
}

model TripBooking {
  id                   String        @id @default(uuid()) @db.Uuid
  householdId          String        @db.Uuid
  tripId               String        @db.Uuid
  type                 BookingType
  status               BookingStatus @default(HOLD)
  provider             String? // airline, hotel, agency
  confirmationRef      String?
  fromLocation         String?
  toLocation           String?
  startAt              DateTime      @db.Timestamptz(6)
  endAt                DateTime?     @db.Timestamptz(6)
  passengerIds         String[]      @db.Uuid // TripPassenger ids covered by this booking
  details              Json          @default("{}") // flight no., seats, room type, address
  amount               Decimal?      @db.Decimal(18, 2)
  currency             String        @default("SAR") @db.Char(3)
  cancellationDeadline DateTime?     @db.Timestamptz(6)
  transactionId        String?       @unique @db.Uuid
  createdById          String        @db.Uuid
  createdAt            DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime      @updatedAt @db.Timestamptz(6)

  household   Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  trip        Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id])

  @@index([tripId, startAt])
  @@map("trip_bookings")
}

// =============================================================================
//  MODULE 9 — DOUBLE-ENTRY LEDGER
// -----------------------------------------------------------------------------
//  The operational tables (petty cash, payroll, salary payments, advances)
//  stay the source of truth for their workflows; the ledger is posted from
//  them by database triggers, exactly once per source event.
//  Invariants (all DB-enforced, see prisma/rls.sql):
//    * every entry balances (Σ debit = Σ credit, ≥ 2 lines) — deferred check;
//    * posted entries/lines are immutable; corrections are reversal entries;
//    * nothing is dated on/before households.booksClosedThrough;
//    * every account/line/entry reference stays inside the household.
// =============================================================================

enum LedgerAccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum JournalSource {
  MANUAL
  OPENING_BALANCE
  REVERSAL
  PETTY_CASH
  PAYROLL
  SALARY_PAYMENT
  SALARY_ADVANCE
  BANK_TRANSACTION
  ACCOUNT_OPENING
}

enum JournalStatus {
  POSTED
  REVERSED
}

/// Chart of accounts. System accounts (isSystem) are seeded per household and
/// cannot be deleted or re-typed; one account per petty-cash float is created
/// automatically. An EXPENSE account mapped to a Category receives that
/// category's petty-cash expenses.
model LedgerAccount {
  id                 String            @id @default(uuid()) @db.Uuid
  householdId        String            @db.Uuid
  code               String            @db.VarChar(10)
  nameI18n           Json              @default("{}")
  type               LedgerAccountType
  parentId           String?           @db.Uuid
  isHeader           Boolean           @default(false) // groups only; no postings
  isSystem           Boolean           @default(false)
  systemKey          String? // stable key for hooks, e.g. "salaries_payable"
  currency           String            @default("SAR") @db.Char(3)
  categoryId         String?           @unique @db.Uuid
  financialAccountId String?           @unique @db.Uuid
  pettyCashAccountId String?           @unique @db.Uuid
  isActive           Boolean           @default(true)
  createdAt          DateTime          @default(now()) @db.Timestamptz(6)

  household        Household         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  parent           LedgerAccount?    @relation("LedgerTree", fields: [parentId], references: [id])
  children         LedgerAccount[]   @relation("LedgerTree")
  category         Category?         @relation(fields: [categoryId], references: [id])
  financialAccount FinancialAccount? @relation(fields: [financialAccountId], references: [id])
  pettyCashAccount PettyCashAccount? @relation(fields: [pettyCashAccountId], references: [id])
  lines            JournalLine[]

  @@unique([householdId, code])
  @@unique([householdId, systemKey])
  @@index([householdId, type])
  @@map("ledger_accounts")
}

model JournalEntry {
  id              String        @id @default(uuid()) @db.Uuid
  householdId     String        @db.Uuid
  number          Int           @default(0) // per-household sequence (JE-000001), set by trigger
  entryDate       DateTime      @db.Date
  descriptionI18n Json          @default("{}")
  source          JournalSource @default(MANUAL)
  /// Id of the operational row that produced the entry (petty_cash_logs, payroll_runs,
  /// salary_payments, salary_advances). Set only by posting hooks; NULL for manual entries.
  sourceId        String?       @db.Uuid
  status          JournalStatus @default(POSTED)
  reversalOfId    String?       @unique @db.Uuid
  reversalReason  String?
  postedById      String?       @db.Uuid // membership; NULL when posted by a system hook
  currency        String        @default("SAR") @db.Char(3)
  createdAt       DateTime      @default(now()) @db.Timestamptz(6)

  household      Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  reversalOf     JournalEntry?  @relation("JournalReversal", fields: [reversalOfId], references: [id])
  reversedBy     JournalEntry?  @relation("JournalReversal")
  lines          JournalLine[]
  fundingMatches FundingMatch[]

  @@unique([householdId, number])
  @@unique([householdId, source, sourceId]) // a source event posts exactly once (NULLs distinct for manual)
  @@index([householdId, entryDate])
  @@map("journal_entries")
}

model JournalLine {
  id              String   @id @default(uuid()) @db.Uuid
  householdId     String   @db.Uuid
  entryId         String   @db.Uuid
  ledgerAccountId String   @db.Uuid
  debit           Decimal  @default(0) @db.Decimal(18, 2)
  credit          Decimal  @default(0) @db.Decimal(18, 2)
  /// Sub-ledger: which worker a receivable / advance / salary line concerns.
  staffId         String?  @db.Uuid
  memo            String?
  createdAt       DateTime @default(now()) @db.Timestamptz(6)

  household Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  entry     JournalEntry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account   LedgerAccount @relation(fields: [ledgerAccountId], references: [id])
  staff     StaffProfile? @relation(fields: [staffId], references: [id])

  @@index([entryId])
  @@index([householdId, ledgerAccountId])
  @@index([staffId])
  @@map("journal_lines")
}

enum StatementFormat {
  CSV
  OFX
}

enum StatementImportStatus {
  PARSED // lines stored and matched; nothing created yet
  APPLIED // unmatched lines turned into transactions, matched ones reconciled
}

enum StatementLineStatus {
  UNMATCHED
  MATCHED // paired with an existing transaction
  CREATED // a transaction was created from it
  IGNORED // user chose to skip it (duplicate, internal transfer…)
}

/// One uploaded bank statement file. The same file (sha256) cannot be imported twice per account.
model BankStatementImport {
  id             String                @id @default(uuid()) @db.Uuid
  householdId    String                @db.Uuid
  accountId      String                @db.Uuid
  format         StatementFormat
  fileName       String
  sha256         String                @db.Char(64)
  periodStart    DateTime?             @db.Date
  periodEnd      DateTime?             @db.Date
  openingBalance Decimal?              @db.Decimal(18, 2)
  closingBalance Decimal?              @db.Decimal(18, 2)
  status         StatementImportStatus @default(PARSED)
  warnings       Json                  @default("[]")
  importedById   String                @db.Uuid
  appliedAt      DateTime?             @db.Timestamptz(6)
  createdAt      DateTime              @default(now()) @db.Timestamptz(6)

  household Household           @relation(fields: [householdId], references: [id], onDelete: Cascade)
  account   FinancialAccount    @relation(fields: [accountId], references: [id])
  lines     BankStatementLine[]

  @@unique([accountId, sha256])
  @@index([householdId, accountId])
  @@map("bank_statement_imports")
}

model BankStatementLine {
  id            String              @id @default(uuid()) @db.Uuid
  householdId   String              @db.Uuid
  importId      String              @db.Uuid
  accountId     String              @db.Uuid
  lineNo        Int
  bookedOn      DateTime            @db.Date
  /// Signed from the account's view: money in > 0, out < 0.
  amount        Decimal             @db.Decimal(18, 2)
  description   String
  reference     String? // bank id (OFX FITID / CSV ref); becomes the created transaction's externalRef
  balance       Decimal?            @db.Decimal(18, 2)
  /// Dedupe across overlapping statements: reference, else date|amount|description|occurrence.
  fingerprint   String
  status        StatementLineStatus @default(UNMATCHED)
  transactionId String?             @unique @db.Uuid
  matchScore    Int?

  household   Household           @relation(fields: [householdId], references: [id], onDelete: Cascade)
  import      BankStatementImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  account     FinancialAccount    @relation(fields: [accountId], references: [id])
  transaction Transaction?        @relation(fields: [transactionId], references: [id])

  @@unique([accountId, fingerprint])
  @@index([importId, status])
  @@map("bank_statement_lines")
}

/// Reconciliation of 1190 Owner funding clearing: links a funding bank
/// transaction (Dr 1190) to the clearing entries it paid for (Cr 1190: petty
/// cash top-ups, salary payments, advances). Amounts are capped by both sides'
/// remaining balance in the database.
model FundingMatch {
  id             String   @id @default(uuid()) @db.Uuid
  householdId    String   @db.Uuid
  transactionId  String   @db.Uuid
  journalEntryId String   @db.Uuid
  amount         Decimal  @db.Decimal(18, 2)
  matchedById    String   @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  household    Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  transaction  Transaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id])

  @@unique([transactionId, journalEntryId])
  @@index([householdId, journalEntryId])
  @@map("funding_matches")
}

// =============================================================================
//  ENCRYPTION KEYS (KMS envelope; see packages/crypto)
// -----------------------------------------------------------------------------
//  Per-tenant data key (DEK) and blind-index key, both stored only in
//  KMS-wrapped form. Plaintext keys never touch the database. Deleting the
//  row and destroying the KMS key version = crypto-shredding the tenant.
// =============================================================================

model TenantKey {
  id              String    @id @default(uuid()) @db.Uuid
  householdId     String    @db.Uuid
  version         Int
  kmsKeyName      String // projects/…/cryptoKeys/household-dek
  wrappedDek      Bytes
  wrappedIndexKey Bytes
  algorithm       String    @default("AES-256-GCM")
  status          String    @default("ACTIVE") // ACTIVE | DECRYPT_ONLY | DESTROYED
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  rotatedAt       DateTime? @db.Timestamptz(6)

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, version])
  @@map("tenant_keys")
}

// =============================================================================
//  CROSS-CUTTING — ATTACHMENTS, REMINDERS, NOTIFICATIONS, AUDIT
// =============================================================================

/// Polymorphic file attachment (FK enforced in service layer).
model Attachment {
  id           String                   @id @default(uuid()) @db.Uuid
  householdId  String                   @db.Uuid
  entityType   AttachmentEntity
  entityId     String                   @db.Uuid
  storageKey   String
  fileName     String
  mimeType     String
  sizeBytes    Int
  isSensitive  Boolean                  @default(false) // passports → short-lived signed URLs only
  uploadedById String                   @db.Uuid
  createdAt    DateTime                 @default(now()) @db.Timestamptz(6)
  /// Staff files: the worker the file belongs to (the worker can see their own files).
  staffId      String?                  @db.Uuid
  category     StaffAttachmentCategory?
  status       AttachmentStatus         @default(PENDING_UPLOAD)
  sha256       String?                  @db.Char(64)
  /// Encrypted at rest with the household DEK (always for sensitive files).
  encrypted    Boolean                  @default(false)
  uploadedAt   DateTime?                @db.Timestamptz(6)

  household Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  staff     StaffProfile? @relation(fields: [staffId], references: [id])

  @@index([householdId, entityType, entityId])
  @@index([staffId, category])
  @@map("attachments")
}

/// Unified expiry/due-date engine: iqama, istimara, insurance, rent, bills.
model Reminder {
  id          String                @id @default(uuid()) @db.Uuid
  householdId String                @db.Uuid
  recipientId String?               @db.Uuid // null = household admins
  entityType  AttachmentEntity
  entityId    String                @db.Uuid
  titleI18n   Json                  @default("{}")
  dueAt       DateTime              @db.Timestamptz(6)
  remindAt    DateTime              @db.Timestamptz(6)
  status      ReminderStatus        @default(PENDING)
  channels    NotificationChannel[] @default([IN_APP, PUSH])

  household     Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  notifications Notification[]
  recipient     Membership?    @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([householdId, entityType, entityId, dueAt, remindAt]) // idempotent sweeps
  @@index([remindAt, status])
  @@index([householdId, dueAt])
  @@map("reminders")
}

// Offline sync: one row per client operation, so a replayed push is answered
// from here instead of being applied twice.
enum SyncOpKind {
  TASK_UPDATE
  INSTRUCTION_COMPLETE
}

enum SyncOpResult {
  APPLIED
  CONFLICT // server changed since the client's baseVersion; response carries the server copy
  REJECTED // refused by validation / RLS; response carries the problem
}

model SyncOperation {
  id           String       @id @default(uuid()) @db.Uuid
  householdId  String       @db.Uuid
  membershipId String       @db.Uuid
  deviceId     String
  opId         String       @db.Uuid // generated on the device
  kind         SyncOpKind
  entityId     String       @db.Uuid
  result       SyncOpResult
  response     Json         @default("{}")
  clientAt     DateTime     @db.Timestamptz(6)
  receivedAt   DateTime     @default(now()) @db.Timestamptz(6)

  household  Household  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([membershipId, opId])
  @@index([householdId, receivedAt])
  @@map("sync_operations")
}

enum NotificationStatus {
  QUEUED // built, waiting for a provider (or no provider configured)
  SENT
  FAILED // provider error; the reminder stays PENDING and is retried
  SKIPPED // could not be addressed (no phone / no device)
}

/// One delivery of one reminder to one user on one channel, with the exact
/// provider payload (WhatsApp Cloud API template message / FCM v1 message)
/// rendered in that user's language. Unique per (reminder, user, channel).
model Notification {
  id                String              @id @default(uuid()) @db.Uuid
  householdId       String              @db.Uuid
  userId            String              @db.Uuid
  channel           NotificationChannel
  templateKey       String
  params            Json                @default("{}")
  deepLink          String?
  readAt            DateTime?           @db.Timestamptz(6)
  sentAt            DateTime?           @db.Timestamptz(6)
  createdAt         DateTime            @default(now()) @db.Timestamptz(6)
  reminderId        String?             @db.Uuid
  locale            Locale              @default(ar)
  title             String              @default("")
  body              String              @default("")
  payload           Json                @default("{}")
  status            NotificationStatus  @default(QUEUED)
  attempts          Int                 @default(0)
  error             String?
  providerMessageId String?

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminder  Reminder? @relation(fields: [reminderId], references: [id], onDelete: SetNull)

  @@unique([reminderId, userId, channel])
  @@index([userId, readAt])
  @@index([status, createdAt])
  @@map("notifications")
}

/// Append-only. Postgres role used by the app has INSERT only (no UPDATE/DELETE).
model AuditLog {
  id          BigInt      @id @default(autoincrement())
  householdId String?     @db.Uuid
  actorUserId String?     @db.Uuid
  action      AuditAction
  entityType  String
  entityId    String?
  before      Json?
  after       Json?
  ip          String?     @db.Inet
  userAgent   String?
  requestId   String? // trace correlation
  createdAt   DateTime    @default(now()) @db.Timestamptz(6)

  household Household? @relation(fields: [householdId], references: [id], onDelete: SetNull)
  actor     User?      @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([householdId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

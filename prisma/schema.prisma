// =============================================================================
//  Household ERP Platform — Prisma Schema (PostgreSQL / Supabase)
// -----------------------------------------------------------------------------
//  Multi-tenancy model : shared database, shared schema, row-level isolation.
//                        Every tenant-owned table carries `householdId`, and
//                        Postgres RLS policies (see prisma/rls.sql) enforce it
//                        in addition to the application-layer guard.
//  i18n model          : user-entered translatable text is stored as JSONB
//                        `{ "ar": "...", "en": "...", "hi": "..." }` in
//                        `*I18n` columns. UI strings live in the frontend
//                        (next-intl / i18next), NOT in the database.
//  Money               : Decimal(18,2) + ISO-4217 currency (default SAR).
//                        Investments use Decimal(24,8) for quantities.
//  Dates               : stored in UTC (timestamptz). Hijri display is a
//                        presentation concern; `hijriDueDate` strings are kept
//                        only where a contract is legally Hijri-dated.
//  Soft delete         : `deletedAt` on business records; financial ledger
//                        rows are immutable (reversed, never deleted).
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pgcrypto, citext, pg_trgm]
}


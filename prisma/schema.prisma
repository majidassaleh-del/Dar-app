  householdId          String    @db.Uuid
  staffId              String    @unique @db.Uuid
  bloodType            BloodType @default(UNKNOWN)
  conditionsCiphertext String?
  allergiesCiphertext  String?
  disclosedById        String?   @db.Uuid
  disclosedAt          DateTime? @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @db.Timestamptz(6)

  household Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  staff     StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@map("staff_health_profiles")
}

enum HandoverItemType {
  VEHICLE_KEY
  HOUSE_KEY
  PHONE
  PAYMENT_CARD
  UNIFORM
  EQUIPMENT
  OTHER
}

enum HandoverStatus {
  PENDING_ACK
  ISSUED
  RETURNED
  LOST
}

/// Issue and return of physical items with the worker's digital sign-off.
/// Items still out block FINAL_EXIT / TERMINATED (exit clearance).
model AssetHandover {
  id                 String                @id @default(uuid()) @db.Uuid
  householdId        String                @db.Uuid
  staffId            String                @db.Uuid
  itemType           HandoverItemType
  descriptionI18n    Json                  @default("{}")
  serialOrTag        String?
  quantity           Int                   @default(1)
  vehicleId          String?               @db.Uuid

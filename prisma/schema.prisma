// =============================================================================
//  IDENTITY, TENANCY & RBAC
// =============================================================================

/// Global identity. Mirrors Supabase `auth.users.id` (same UUID) so RLS can
/// use `auth.uid()`. A user can belong to many households.
model User {
  id              String    @id @db.Uuid // = auth.users.id
  phone           String?   @unique // E.164; primary login for staff (OTP)
  email           String?   @unique @db.Citext
  fullNameI18n    Json      @default("{}") // { "ar": "...", "en": "..." }
  preferredLocale Locale    @default(ar)
  timezone        String    @default("Asia/Riyadh")
  avatarUrl       String?
  nationality     String?   @db.Char(2) // ISO-3166 alpha-2
  lastLoginAt     DateTime? @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt       DateTime? @db.Timestamptz(6)

  memberships    Membership[]
  devices        UserDevice[]
  authFactor     UserAuthFactor?
  authChallenges AuthChallenge[]
  deviceKeys     DeviceKey[]
  notifications  Notification[]
  auditLogs      AuditLog[]      @relation("AuditActor")

  @@map("users")
}

enum AuthChallengeKind {
  PHONE_OTP
  EMAIL_OTP
  DEVICE_UNLOCK
}

/// First-time onboarding factors: SMS OTP (phone), email OTP, and an authenticator app
/// (TOTP, e.g. Microsoft Authenticator). Written only through app.* definer functions;
/// onboardedAt is set by trigger once all three are verified.
model UserAuthFactor {
  userId               String    @id @db.Uuid
  phone                String?
  phoneVerifiedAt      DateTime? @db.Timestamptz(6)
  email                String?   @db.Citext
  emailVerifiedAt      DateTime? @db.Timestamptz(6)
  totpSecretCiphertext String? // AES-256-GCM under AUTH_TOTP_KEY
  totpVerifiedAt       DateTime? @db.Timestamptz(6)
  totpLastStep         BigInt? // replay protection: a TOTP step is accepted once
  totpFailures         Int       @default(0)
  totpLockedUntil      DateTime? @db.Timestamptz(6) // 15 min after 5 wrong codes
  onboardedAt          DateTime? @db.Timestamptz(6)
  updatedAt            DateTime  @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_auth_factors")
}

/// One-time codes and device-unlock nonces; only a hash is stored. Consumed through
/// app.consume_auth_challenge (attempt limit, expiry, single use).
model AuthChallenge {
  id         String            @id @default(uuid()) @db.Uuid
  userId     String            @db.Uuid
  kind       AuthChallengeKind
  target     String? // phone / email being verified, device key id for unlock
  codeHash   String
  attempts   Int               @default(0)
  expiresAt  DateTime          @db.Timestamptz(6)
  consumedAt DateTime?         @db.Timestamptz(6)
  createdAt  DateTime          @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("auth_challenges")
}

/// Device-bound key (P-256) whose private half sits in the Secure Enclave / Android
/// Keystore behind Face ID / Touch ID. Signing a server nonce is the daily unlock.
model DeviceKey {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  deviceId     String
  publicKeyJwk Json
  label        String?
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  lastUsedAt   DateTime? @db.Timestamptz(6)
  revokedAt    DateTime? @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@map("device_keys")
}

model UserDevice {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  platform   String // ios | android | web
  pushToken  String   @unique
  appVersion String?
  lastSeenAt DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_devices")
}

/// The tenant.
model Household {
  id                 String           @id @default(uuid()) @db.Uuid
  slug               String           @unique
  nameI18n           Json             @default("{}")
  defaultLocale      Locale           @default(ar)
  enabledLocales     Locale[]         @default([ar, en])
  baseCurrency       String           @default("SAR") @db.Char(3)
  countryCode        String           @default("SA") @db.Char(2)
  timezone           String           @default("Asia/Riyadh")
  weekStartDay       Int              @default(0) // 0 = Sunday
  fiscalYearStart    Int              @default(1) // month 1..12
  plan               SubscriptionPlan @default(FREE)
  planRenewsAt       DateTime?        @db.Timestamptz(6)
  settings           Json             @default("{}") // feature flags, approval thresholds
  /// Ledger period lock: no journal entry may be dated on or before this date. Set via app.close_books().
  booksClosedThrough DateTime?        @db.Date
  createdAt          DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @db.Timestamptz(6)
  deletedAt          DateTime?        @db.Timestamptz(6)

  memberships           Membership[]
  roles                 Role[]
  staff                 StaffProfile[]
  identityDocs          IdentityDocument[]
  contracts             EmploymentContract[]
  payrollRuns           PayrollRun[]
  salaryPayments        SalaryPayment[]
  payrollLines          PayrollLine[]
  salaryAdvances        SalaryAdvance[]
  leaves                LeaveRecord[]
  attendance            Attendance[]
  tasks                 HouseholdTask[]
  financialAccounts     FinancialAccount[]
  cards                 Card[]
  categories            Category[]
  transactions          Transaction[]
  receipts              Receipt[]
  budgets               Budget[]
  recurringRules        RecurringRule[]
  allowances            AllowancePlan[]
  requests              Request[]
  approvals             Approval[]
  approvalPolicies      ApprovalPolicy[]
  portfolios            Portfolio[]
  assets                Asset[]
  holdings              Holding[]
  investmentTxns        InvestmentTransaction[]
  valuations            AssetValuation[]
  vehicles              Vehicle[]
  vehicleAssignments    VehicleAssignment[]
  maintenance           MaintenanceRecord[]
  fuelLogs              FuelLog[]
  violations            TrafficViolation[]
  tripLogs              TripLog[]
  properties            Property[]
  propertyUnits         PropertyUnit[]
  leases                Lease[]
  rentPayments          RentPayment[]
  utilityBills          UtilityBill[]
  tickets               MaintenanceTicket[]
  attachments           Attachment[]
  reminders             Reminder[]
  syncOperations        SyncOperation[]
  esbAccruals           EsbAccrual[]
  maintenancePlans      MaintenancePlan[]
  odometerReadings      OdometerReading[]
  notifications         Notification[]
  auditLogs             AuditLog[]
  tenantKeys            TenantKey[]
  ledgerAccounts        LedgerAccount[]
  journalEntries        JournalEntry[]
  journalLines          JournalLine[]
  fundingMatches        FundingMatch[]
  statementImports      BankStatementImport[]
  statementLines        BankStatementLine[]
  medicalCheckups       MedicalCheckup[]
  healthProfiles        StaffHealthProfile[]
  assetHandovers        AssetHandover[]
  staffEvaluations      StaffEvaluation[]
  staffTrainings        StaffTraining[]
  policies              Policy[]
  codesOfEthics         CodeOfEthics[]
  privacyAgreements     PrivacyAgreement[]
  acknowledgments       PolicyAcknowledgment[]
  pettyCashAccounts     PettyCashAccount[]
  pettyCashLogs         PettyCashLog[]
  workOrders            WorkOrder[]
  workOrderInstructions WorkOrderInstruction[]
  trips                 Trip[]
  tripPassengers        TripPassenger[]
  tripBookings          TripBooking[]

  @@map("households")
}

/// User ↔ Household link. This is the security principal for every
/// tenant-scoped operation (all `createdById`, `assigneeId` etc. point here,
/// not at User, so access is always evaluated inside a tenant).
model Membership {
  id           String           @id @default(uuid()) @db.Uuid
  householdId  String           @db.Uuid
  userId       String           @db.Uuid
  roleId       String           @db.Uuid
  status       MembershipStatus @default(INVITED)
  displayName  String? // nickname inside this household ("Mama", "Abu Ahmed")
  relationship String? // son, daughter, mother-in-law ...
  dateOfBirth  DateTime?        @db.Date // drives dependent age-gating
  guardianId   String?          @db.Uuid // dependent → parent membership
  invitedById  String?          @db.Uuid
  expiresAt    DateTime?        @db.Timestamptz(6) // guests, temp staff
  joinedAt     DateTime?        @db.Timestamptz(6)
  createdAt    DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @db.Timestamptz(6)

  household Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role         @relation(fields: [roleId], references: [id])
  guardian  Membership?  @relation("Guardianship", fields: [guardianId], references: [id])
  wards     Membership[] @relation("Guardianship")

  permissionOverrides MembershipPermission[]
  staffProfile        StaffProfile?
  cardsHeld           Card[]                 @relation("CardHolder")
  transactionsCreated Transaction[]          @relation("TxnCreatedBy")
  transactionsSpent   Transaction[]          @relation("TxnSpentBy")
  receiptsUploaded    Receipt[]
  requestsMade        Request[]              @relation("Requester")
  approvals           Approval[]             @relation("Approver")
  allowancePlans      AllowancePlan[]
  tasksAssigned       HouseholdTask[]        @relation("TaskAssignee")
  tasksCreated        HouseholdTask[]        @relation("TaskCreator")
  vehicleAssignments  VehicleAssignment[]
  tripLogs            TripLog[]
  ticketsAssigned     MaintenanceTicket[]    @relation("TicketAssignee")
  ticketsReported     MaintenanceTicket[]    @relation("TicketReporter")
  financialAccounts   FinancialAccount[]     @relation("AccountCustodian")
  budgetsOwned        Budget[]
  reminders           Reminder[]
  syncOperations      SyncOperation[]
  fuelLogs            FuelLog[]              @relation("FuelDriver")
  odometerReadings    OdometerReading[]
  acknowledgments     PolicyAcknowledgment[] @relation("AckSigner")
  witnessedAcks       PolicyAcknowledgment[] @relation("AckWitness")
  pettyCashAccounts   PettyCashAccount[]     @relation("PettyCashCustodian")
  pettyCashLogs       PettyCashLog[]         @relation("PettyCashRecorder")
  workOrdersRequested WorkOrder[]            @relation("WorkOrderRequester")
  workOrdersAssigned  WorkOrder[]            @relation("WorkOrderAssignee")
  tripsOrganized      Trip[]
  tripSeats           TripPassenger[]

  @@unique([householdId, userId])
  @@index([householdId, status])
  @@index([userId])
  @@map("memberships")
}

/// Per-household role (seeded from SystemRole templates, customisable).
model Role {
  id          String     @id @default(uuid()) @db.Uuid
  householdId String     @db.Uuid
  systemRole  SystemRole
  nameI18n    Json       @default("{}")
  isDefault   Boolean    @default(false) // seeded template, cannot delete
  createdAt   DateTime   @default(now()) @db.Timestamptz(6)

  household   Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  memberships Membership[]

  @@unique([householdId, systemRole, isDefault])
  @@index([householdId])
  @@map("roles")
}

/// Global permission catalogue, e.g. "finance.transaction.read",
/// "staff.salary.read", "fleet.vehicle.assign". Not tenant-scoped.
model Permission {
  id          String  @id // the key itself, e.g. "finance.card.manage"
  module      String // staff | finance | invest | fleet | property | admin
  description String?

  roles     RolePermission[]
  overrides MembershipPermission[]

  @@map("permissions")
}

/// `scope` narrows a permission: ALL (whole household), OWN (records the
/// member owns/created), ASSIGNED (records assigned to the member),
/// WARDS (records of dependents the member is guardian of).
model RolePermission {
  roleId       String @db.Uuid
  permissionId String
  scope        String @default("ALL") // ALL | OWN | ASSIGNED | WARDS

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model MembershipPermission {
  membershipId String  @db.Uuid
  permissionId String
  granted      Boolean // true = grant, false = explicit deny (deny wins)
  scope        String  @default("ALL")

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([membershipId, permissionId])
  @@map("membership_permissions")
}

// =============================================================================
//  MODULE 1 — DOMESTIC STAFF HR
// =============================================================================

model StaffProfile {
  id                     String                @id @default(uuid()) @db.Uuid
  householdId            String                @db.Uuid
  membershipId           String?               @unique @db.Uuid // null until staff gets app access
  staffType              StaffType
  status                 EmploymentStatus      @default(RECRUITING)
  fullNameI18n           Json                  @default("{}") // name as in passport + Arabic transliteration
  nationality            String                @db.Char(2)
  gender                 String?
  dateOfBirth            DateTime?             @db.Date
  religion               String?
  preferredLocale        Locale                @default(en)
  phone                  String?
  emergencyContact       Json? // { name, phone, relation, country }
  recruitmentAgency      String?
  musanedRef             String? // government domestic-labour platform reference
  borderNumberCiphertext String? // KMS envelope
  /// How salary is normally paid. Domestic workers are outside WPS/Mudad:
  /// Musaned salary transfer, bank transfer, cash and wallets are all legal.
  defaultPayoutChannel   SalaryPaymentChannel?
  payoutIbanCiphertext   String? // KMS envelope (direct bank transfer)
  payoutIbanBlindIndex   String?
  payoutIbanLast4        String?               @db.VarChar(4)
  payoutWalletRef        String? // Musaned / wallet account reference (not secret, display only)
  hireDate               DateTime?             @db.Date
  probationEndsAt        DateTime?             @db.Date
  terminationDate        DateTime?             @db.Date
  weeklyDayOff           Int? // 0..6
  livesIn                Boolean               @default(true)
  notes                  String?
  createdAt              DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime              @updatedAt @db.Timestamptz(6)
  deletedAt              DateTime?             @db.Timestamptz(6)

  household       Household            @relation(fields: [householdId], references: [id], onDelete: Cascade)
  membership      Membership?          @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  documents       IdentityDocument[]
  contracts       EmploymentContract[]
  payrollLines    PayrollLine[]
  advances        SalaryAdvance[]
  leaves          LeaveRecord[]
  attendance      Attendance[]
  violations      TrafficViolation[]
  tripSeats       TripPassenger[]
  salaryPayments  SalaryPayment[]
  journalLines    JournalLine[]
  attachments     Attachment[]
  medicalCheckups MedicalCheckup[]
  healthProfile   StaffHealthProfile?
  handovers       AssetHandover[]
  evaluations     StaffEvaluation[]
  trainings       StaffTraining[]
  esbAccruals     EsbAccrual[]

  @@index([householdId, status])
  @@index([householdId, staffType])
  @@map("staff_profiles")
}

/// Passports, iqamas, visas, licences — the #1 source of expiry reminders.
model IdentityDocument {
  id               String               @id @default(uuid()) @db.Uuid
  householdId      String               @db.Uuid
  staffId          String               @db.Uuid
  type             IdentityDocumentType
  numberCiphertext String // KMS envelope (packages/crypto) — AAD binds it to household + column
  numberBlindIndex String // HMAC-SHA256(normalised number, tenant index key) → exact-match lookup
  numberLast4      String?              @db.VarChar(4) // display only
  issuingCountry   String?              @db.Char(2)
  issueDate        DateTime?            @db.Date
  expiryDate       DateTime?            @db.Date
  heldByEmployer   Boolean              @default(false) // passport custody tracking
  /// Alert tiers in days before expiry (default 60 / 30 / 15). Household default in households.settings.documentAlertDays.
  alertDays        Int[]                @default([60, 30, 15])
  createdAt        DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime             @updatedAt @db.Timestamptz(6)

  household      Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  staff          StaffProfile    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  tripPassengers TripPassenger[]

  @@unique([householdId, type, numberBlindIndex])
  @@index([householdId, expiryDate])
  @@index([staffId, type])
  @@map("identity_documents")
}

model EmploymentContract {

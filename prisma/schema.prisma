model SalaryAdvance {
  id                 String    @id @default(uuid()) @db.Uuid
  householdId        String    @db.Uuid
  staffId            String    @db.Uuid
  requestId          String?   @unique @db.Uuid
  amount             Decimal   @db.Decimal(18, 2)
  outstanding        Decimal   @db.Decimal(18, 2)
  monthlyInstallment Decimal   @db.Decimal(18, 2)
  currency           String    @default("SAR") @db.Char(3)
  issuedAt           DateTime  @db.Date
  settledAt          DateTime? @db.Date

  household    Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  staff        StaffProfile  @relation(fields: [staffId], references: [id])
  request      Request?      @relation(fields: [requestId], references: [id])
  payrollLines PayrollLine[]

  @@index([staffId, settledAt])
  @@map("salary_advances")
}

enum SalaryPaymentChannel {
  MUSANED // salary transfer through the Musaned platform / its wallet
  BANK_TRANSFER // direct transfer to the worker's own account
  CASH // hand-paid; the worker's acknowledgment is the evidence
  DIGITAL_WALLET // STC Pay, urpay, etc.
}

enum SalaryPaymentStatus {
  RECORDED // employer logged the payment
  ACKNOWLEDGED // worker confirmed receipt in the app
  DISPUTED // worker says it was not (fully) received
  REVERSED // employer voided it (wrong entry); corrections are a new row
}

/// Domestic-worker salary log. Deliberately NOT a WPS/Mudad file: household
/// employers are outside WPS, so there is no IBAN-at-Saudi-bank or SIF
/// constraint. What matters for a labour dispute is evidence: period, amount,
/// channel, the transfer reference, and the worker's own acknowledgment.
/// Immutable after insert apart from status transitions (DB trigger).
model SalaryPayment {
  id             String                @id @default(uuid()) @db.Uuid
  householdId    String                @db.Uuid
  staffId        String                @db.Uuid
  payrollRunId   String?               @db.Uuid
  periodYear     Int
  periodMonth    Int
  amount         Decimal               @db.Decimal(18, 2)
  currency       String                @default("SAR") @db.Char(3)
  channel        SalaryPaymentChannel
  status         SalaryPaymentStatus   @default(RECORDED)
  externalRef    String? // Musaned transfer no. / bank reference; required for MUSANED and BANK_TRANSFER
  payoutLast4    String?               @db.VarChar(4) // last 4 of the IBAN/wallet paid into
  paidAt         DateTime              @db.Timestamptz(6)
  note           String?
  proofFileId    String?               @db.Uuid // Attachment (transfer slip, signed cash voucher)
  recordedById   String                @db.Uuid
  acknowledgedAt DateTime?             @db.Timestamptz(6)
  ackMethod      AcknowledgmentMethod?
  disputeReason  String?
  reversedAt     DateTime?             @db.Timestamptz(6)
  reversalReason String?
  transactionId  String?               @unique @db.Uuid
  createdAt      DateTime              @default(now()) @db.Timestamptz(6)

  household   Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  staff       StaffProfile @relation(fields: [staffId], references: [id])
  payrollRun  PayrollRun?  @relation(fields: [payrollRunId], references: [id])
  transaction Transaction? @relation(fields: [transactionId], references: [id])

  @@index([staffId, periodYear, periodMonth])
  @@index([householdId, status])
  @@map("salary_payments")
}

/// Monthly end-of-service snapshot per worker (written by the worker job `esb:accrue`).
/// `vested` is what would be owed if the contract ended at month end; `provision`
/// is the accrual for the books (pro rata towards the next entitlement).
model EsbAccrual {
  id          String   @id @default(uuid()) @db.Uuid
  householdId String   @db.Uuid
  staffId     String   @db.Uuid
  periodYear  Int
  periodMonth Int
  rule        String
  serviceDays Int
  monthlyWage Decimal  @db.Decimal(18, 2)
  vested      Decimal  @db.Decimal(18, 2)
  provision   Decimal  @db.Decimal(18, 2)
  delta       Decimal  @db.Decimal(18, 2) // provision change vs the previous snapshot
  currency    String   @default("SAR") @db.Char(3)
  detail      Json     @default("{}")
  computedAt  DateTime @default(now()) @db.Timestamptz(6)

  household Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  staff     StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, periodYear, periodMonth])
  @@index([householdId, periodYear, periodMonth])
  @@map("esb_accruals")
}

// ---- Staff HR extension: health, medical checkups, handovers, evaluations, training ----

enum BloodType {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG
  UNKNOWN
}

enum MedicalResult {
  PENDING_RESULTS
  FIT
  FIT_WITH_RESTRICTIONS
  UNFIT
}

/// Annual medical checkup. Mandatory for EVERY staff role (no job-type exemption):
/// a worker cannot become ACTIVE without a valid FIT / FIT_WITH_RESTRICTIONS result,
/// and 60/30/15-day reminders run before it lapses.
model MedicalCheckup {
  id                     String        @id @default(uuid()) @db.Uuid
  householdId            String        @db.Uuid
  staffId                String        @db.Uuid
  checkupDate            DateTime      @db.Date
  validUntil             DateTime      @db.Date
  result                 MedicalResult @default(PENDING_RESULTS)
  clinicName             String?
  restrictionsCiphertext String? // KMS envelope: restrictions / doctor notes (health data)
  reportAttachmentId     String?       @db.Uuid
  recordedById           String        @db.Uuid
  createdAt              DateTime      @default(now()) @db.Timestamptz(6)

  household Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  staff     StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, validUntil])
  @@map("medical_checkups")
}

/// Streamlined health record. Health data is PDPL "sensitive": conditions and
/// allergies are encrypted; only staff.health.read (Head / EFA) and the worker see it.
model StaffHealthProfile {

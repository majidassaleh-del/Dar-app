NODE_ENV=development
PORT=4000
# Login role with NO table privileges and NO BYPASSRLS; requests SET ROLE to DB_REQUEST_ROLE.
DATABASE_URL=postgresql://herp_api:herp_api_dev@localhost:5432/herp_dev
DB_REQUEST_ROLE=app_user            # "authenticated" on Supabase
# Dev: HS256 secret (>= 32 chars). Production: AUTH_JWKS_URL (required when NODE_ENV=production).
AUTH_JWT_SECRET=dev-secret-dev-secret-dev-secret-0123
# AUTH_JWKS_URL=https://<project>.supabase.co/auth/v1/.well-known/jwks.json
# AUTH_ISSUER=
# AUTH_AUDIENCE=authenticated

NODE_ENV=development
PORT=4000
# Public origins (https required in production), e.g. for the SaaS domain darerp.net:
# PUBLIC_APP_URL=https://app.darerp.net
# PUBLIC_API_URL=https://api.darerp.net
# Browser origins allowed by CORS (comma-separated; exact or one-label wildcard; "*" is refused).
# The web app calls the API server-side and the mobile app sends no Origin, so this only matters
# for browser clients on other origins. Unset = no cross-origin browser access.
#   Production: CORS_ORIGINS=https://darerp.net,https://app.darerp.net,https://*.darerp.net
#   Local:      CORS_ORIGINS=http://localhost:3000,http://*.localhost:3000
CORS_ORIGINS=
# Reverse-proxy hops to trust for X-Forwarded-For / -Proto (1 behind one load balancer; 0 when exposed directly).
TRUST_PROXY=0
# Login role with NO table privileges and NO BYPASSRLS; requests SET ROLE to DB_REQUEST_ROLE.
DATABASE_URL=postgresql://herp_api:herp_api_dev@localhost:5432/herp_dev
DB_REQUEST_ROLE=app_user            # "authenticated" on Supabase
# Dev: HS256 secret (>= 32 chars). Production: AUTH_JWKS_URL (required when NODE_ENV=production).
AUTH_JWT_SECRET=dev-secret-dev-secret-dev-secret-0123
# AUTH_JWKS_URL=https://<project>.supabase.co/auth/v1/.well-known/jwks.json
# AUTH_ISSUER=
# AUTH_AUDIENCE=authenticated
# Invitation-only accounts. Public sign-up is DISABLED at the identity provider; the API creates the
# sign-in identity itself, only while an owner-issued invitation is accepted, through the provider's
# admin API with the service-role key (server-side secret: never in the web app, never in a browser).
# Required in production, together with PUBLIC_APP_URL (invitation links). Local: http://localhost:9999/auth/v1
# AUTH_ADMIN_URL=https://<project>.supabase.co/auth/v1
# AUTH_ADMIN_KEY=<service_role key>
# Name in verification messages / the authenticator app before the person belongs to a household
# (afterwards the household's own name is used).
# AUTH_BRAND_NAME=Dar ERP
# Field encryption (Iqama / passport / IBAN). Dev: local KEK, 32 random bytes base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
HERP_KMS=local
HERP_LOCAL_KEK=
# Production: HERP_KMS=gcp and HERP_KMS_KEY=projects/<p>/locations/me-central2/keyRings/herp/cryptoKeys/household-dek
# Worker jobs (node dist/worker.js keys:provision | reminders:documents)
WORKER_DATABASE_URL=postgresql://herp_worker:herp_worker_dev@localhost:5432/herp_dev

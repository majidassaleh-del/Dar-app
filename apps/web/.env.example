# apps/web — server-side settings (none are exposed to the browser).

# API base URL, called server-to-server (no CORS needed for these calls).
HERP_API_URL=http://localhost:4000
# Production on the SaaS domain:
# HERP_API_URL=https://api.darhub.net

# Session cookie holding the bearer token (httpOnly), set by the sign-in flow.
# Production: __Secure-herp_session (browser-enforced Secure).
HERP_SESSION_COOKIE=herp_session
# The household chosen in the switcher on the app host (httpOnly).
HERP_HOUSEHOLD_COOKIE=herp_household
# Cookie Domain. Unset = host-only. ".darhub.net" lets one sign-in cover app.darhub.net and every tenant subdomain.
# HERP_COOKIE_DOMAIN=.darhub.net
# Secure cookies are always on in production; set true on an https staging host running in development mode.
# HERP_COOKIE_SECURE=true

# Tenant subdomains: <household slug>.<base>. efa.darhub.net is pinned to the household with slug "efa"
# (the API still requires an active membership; non-members get a 404). Unset = no subdomain routing.
# HERP_TENANT_BASE_DOMAIN=darhub.net
# Local stand-in: HERP_TENANT_BASE_DOMAIN=localhost, then open http://efa.localhost:3000
# Subdomains that are never a household slug.
HERP_TENANT_RESERVED=app,www,api,admin,auth,static,cdn,mail,status

# Development only (ignored when NODE_ENV=production): a bearer token for a local API,
# printed by scripts/demo-seed.mjs.
# HERP_DEV_TOKEN=
